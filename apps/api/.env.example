PORT=3000
DATABASE_URL="postgresql://hotel:hotel_secret@localhost:6432/hotel_db"
JWT_ACCESS_SECRET=change_me_access_secret_min_32chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32chars
RABBITMQ_URL=amqp://hotel:rabbit_secret@localhost:5672/hotel_vhost
REDIS_URL=redis://:redis_secret@localhost:6379
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Email / Resend
RESEND_API_KEY=re_example_resend_api_key
EMAIL_FROM=Sapphire Stay <onboarding@resend.dev>

# VNPay
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3001/payment/result

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Stream Chat
STREAM_CHAT_API_KEY=your_stream_chat_api_key
STREAM_CHAT_API_SECRET=your_stream_chat_api_secret

# Cron
CRON_SECRET=your_cron_secret
